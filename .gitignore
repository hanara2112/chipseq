# =============================================================
# .gitignore — H3K27ac ChIP-seq assignment
# Strategy: track scripts + small results + docs.
#           ignore raw data, large binaries, regenerable artefacts.
# =============================================================

# ---- raw + reference data (large, regenerable) --------------
# 1.5 GB raw FASTQs
data/student_dataset/
# post-trim FASTQs (regenerable)
data/trimmed/*.fq.gz
data/trimmed/*.fastq.gz
# per-file fastqc artefacts
data/trimmed/*_fastqc.html
data/trimmed/*_fastqc.zip
# all BAMs are large + regenerable
data/aligned/*.bam
data/aligned/*.bam.bai
data/aligned/*.sam
# 3.5 GB Bowtie2 index (keep only the build script)
data/genome/*
!data/genome/make_mm10.sh

# ---- coverage tracks (large, regenerable) -------------------
results/coverage/*.bw

# ---- raw multiqc data dir (HTML report itself is tracked) ---
results/qc/multiqc_report_data/
results/qc/fastqc_raw/

# ---- archives -----------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz

# ---- editor / OS / IDE junk ---------------------------------
.DS_Store
.idea/
.vscode/
.claude/
*.swp
*~

# ---- R / RStudio --------------------------------------------
.Rhistory
.RData
.Rproj.user/
*.Rproj
# RMarkdown render side-effects (cache dirs only)
*_files/
*_cache/

# ---- python / conda -----------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- build / temp -------------------------------------------
nohup.out
*.log.tmp
